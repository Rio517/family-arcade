{
  "name": "family-arcade",
  "version": "1.0.0",
  "private": true,
  "description": "The Kny-Flores family arcade: an offline-first PWA console of peer-to-peer games — Magic Coins, Rainbow Racer, Ship Battle, Chess, Risk, and a Yahtzee calculator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip",
    "shots": "node scripts/screenshots.mjs",
    "glb": "node scripts/optimize-glb.mjs",
    "risk:drag": "node scripts/risk-drag-check.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "peerjs": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "knip": "^6.31.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tidewave": "^0.8.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
