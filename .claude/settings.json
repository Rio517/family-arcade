{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm install -D:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run knip:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run shots:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx knip:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite build:*)",
      "Bash(npx vite preview:*)",
      "Bash(npx vitest:*)",
      "Bash(node scripts/:*)",
      "Bash(curl -I:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sf:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(lsof:*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(npm publish:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Write(~/.claude/.credentials.json)",
      "Bash(cat ~/.claude/.credentials.json:*)",
      "Bash(cp ~/.claude/.credentials.json:*)",
      "Bash(grep * ~/.claude/.credentials.json:*)",
      "Bash(head ~/.claude/.credentials.json:*)",
      "Bash(jq * ~/.claude/.credentials.json:*)",
      "Bash(mv ~/.claude/.credentials.json:*)",
      "Bash(tail ~/.claude/.credentials.json:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-compound-commands.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-critical-rules.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tidewave-autostart.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
